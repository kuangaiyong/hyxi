# 敏感配置
.env
.scraper_state.json

# 运行时数据。持久化已统一到 hyxi.db，下面几条 JSON 是迁移前的遗留形态，
# 保留规则是为了让老部署升上来时不会把它们误提交
backend/data/config.json
backend/data/scheduler.db
backend/data/tasks.json
backend/data/scheduled_tasks.json
backend/data/sentiment_*.json
backend/data/_migrated_backup/
backend/data/exports/
backend/data/hyxi.db*
backend/data/logs/
backend/data/jobs/
backend/data/sessions/
backend/data/media/

# 依赖
node_modules/
frontend/node_modules/

# Python
__pycache__/
*.pyc
.venv/
venv/

# 构建产物
frontend/dist/
frontend/tsconfig.tsbuildinfo
# 便携包的中间产物与成品（几百 MB，且 build/out/collectors 是压缩后的采集脚本）
build/out/
build/*.log

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# 抓取的帖子数据（体积大，按需拉取）
tweakers_thread_*.json
group_feed_*.json
facebook_group_*.json
